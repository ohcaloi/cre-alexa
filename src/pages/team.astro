---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/pages.css";

// Team members. Add a photo path (in public/images) to show a portrait instead of initials.
const team: { name: string; role: string; bio: string; photo?: string }[] = [
  {
    name: "Alexa Barnett",
    role: "Founder",
    bio: "Founder of CRE Alexa. She loves to chat, so book a call any time.",
  },
];
const initials = (name: string) => name.split(" ").map((part) => part[0]).join("").slice(0, 2);
---

<SiteLayout title="Team | CRE Alexa" description="Meet the people behind CRE Alexa's commercial real estate events in Nashville and Austin.">
  <section class="page-intro" aria-labelledby="team-title">
    <p class="kicker"><span aria-hidden="true"></span> Team</p>
    <h1 id="team-title">The people behind the <em>party.</em></h1>
    <p>Meet the people who make CRE Alexa happen.</p>
  </section>

  <ul class="team-grid">
    {team.map((person) => (
      <li class="team-card glass-panel" data-rise>
        {person.photo
          ? <img class="team-photo" src={person.photo} alt={`Portrait of ${person.name}`} loading="lazy" decoding="async" />
          : <span class="team-photo team-initials" aria-hidden="true">{initials(person.name)}</span>}
        <div>
          <p class="team-role">{person.role}</p>
          <h2>{person.name}</h2>
          <p>{person.bio}</p>
          <a class="text-link" href="/#contact-form">Schedule a call <span aria-hidden="true">↗</span></a>
        </div>
      </li>
    ))}
  </ul>
</SiteLayout>
