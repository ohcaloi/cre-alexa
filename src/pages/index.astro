---
import SiteLayout from "../layouts/SiteLayout.astro";
import ContactForm from "../components/ContactForm";
import { fetchEvents } from "../wix/events/events";
import { fetchPosts, postPath } from "../wix/blog/posts";
import { getForm } from "../wix/forms/forms";

const formId = "c8e6090e-0ccc-4bba-b5ea-47b049e81f05";
const heroPhoto = "https://static.wixstatic.com/media/0970ad_93ca85552d0b4a2b99bcde20f9320b47~mv2.jpg";
const [events, posts, contactForm] = await Promise.all([
  fetchEvents({ limit: 36 }).catch(() => []),
  fetchPosts({ limit: 3 }).then((page) => page.posts).catch(() => []),
  getForm(formId).catch(() => undefined),
]);
const nextEvents = events.filter((event) =>
  /\b(?:real estate|networking|property|CRE(?! Alexa))\b/i.test(event.title) &&
  (event.dateTbd || Date.parse(event.endDateIso || event.startDateIso) > Date.now())
).slice(0, 3);
const cities = [
  { city: "Nashville", state: "Tennessee", chapter: "CRE615", url: "https://www.cre615.com/", events: "https://www.cre615.com/upcoming-events", copy: "Meet Nashville’s CRE community at happy hours, volunteer days and the Changemakers Summit." },
  { city: "Austin", state: "Texas", chapter: "CRE512", url: "https://www.cre512.com/", events: "https://www.cre512.com/upcoming-events", copy: "Get to know the people working across Austin’s commercial real estate industry." },
];
---
<SiteLayout home title="CRE Alexa | Commercial Real Estate Networking in Nashville & Austin"
  description="Meet commercial real estate professionals in Nashville and Austin. Explore CRE events, industry articles, booking services and resources from CRE Alexa."
  image={heroPhoto}>
  <section class="hero" data-enter data-hero="photo" aria-labelledby="hero-title">
    <div class="hero-photo hero__media" aria-hidden="true">
      <img src={heroPhoto} alt="" width="1536" height="1024" fetchpriority="high" />
    </div>
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="kicker"><span aria-hidden="true"></span> Nashville &amp; Austin</p>
        <h1 id="hero-title">Meet your <br />CRE community<span>.</span></h1>
        <p class="hero__lead">Get to know the people in commercial real estate through local events, industry resources and one-on-one conversations.</p>
        <a class="button btn" href="#communities">Find your community <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="communities section" id="communities" aria-labelledby="community-title" data-moment="word-highlight">
    <div class="wrap">
      <div class="section-head">
        <h2 id="community-title">Find your local network</h2>
        <p class="mo-wh__text">Both chapters bring together people working in <strong>brokerage, development, finance</strong> and property management.</p>
      </div>
      <div class="city-grid">
        {cities.map((place) => (
          <article class="city-card card">
            <div class="city-top"><span>{place.chapter}</span><span>{place.state}</span></div>
            <h3>{place.city}<span>.</span></h3>
            <p>{place.copy}</p>
            <div class="city-actions">
              <a class="text-link" href={place.url}>Visit {place.chapter} <span aria-hidden="true">↗</span></a>
              <a class="text-link" href={place.events}>See local events <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="events-band section" aria-labelledby="events-title">
    <div class="wrap feature-split">
      <div class="feature-copy">
        <h2 id="events-title">CRE events</h2>
        <p>Meet peers at a mixer, hear how others approach their work at a workshop, or volunteer with your local chapter.</p>
        <a class="button" href="/events">Browse CRE events <span aria-hidden="true">↗</span></a>
      </div>
      <div class="event-list">
        {nextEvents.length ? nextEvents.map((event) => (
          <a class="event-row" href={`/events/${encodeURIComponent(event.slug)}`}>
            <div><p class="row-meta">{event.dateLabel || "Date to be announced"}</p><h3>{event.title}</h3>{event.locationName && <p>{event.locationName}</p>}</div>
            <span aria-hidden="true">↗</span>
          </a>
        )) : cities.map((place) => (
          <a class="event-row" href={place.events}>
            <div><p class="row-meta">{place.chapter}</p><h3>{place.city} event calendar</h3></div>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class:list={["resources section", posts.length === 3 && "resources-with-posts"]} id="resources" aria-labelledby="resources-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="resources-title">Commercial real estate resources</h2>
        <p>Read up on industry topics, browse tools for your work, or book time to talk through a question.</p>
      </div>
      <div class="resource-grid">
        <a class="resource-link card" href="/blog"><span>Industry articles</span><p>Read the CRE Alexa blog.</p><i aria-hidden="true">↗</i></a>
        <a class="resource-link card" href="/shop"><span>Shop resources</span><p>Browse tools and work essentials.</p><i aria-hidden="true">↗</i></a>
        <a class="resource-link card" href="/services"><span>Book a session</span><p>Explore consultations and training.</p><i aria-hidden="true">↗</i></a>
      </div>
      {posts.length > 0 && (
        <div class="journal">
          <div class="journal-head"><h3>From the blog</h3><a class="text-link" href="/blog">See all articles <span aria-hidden="true">↗</span></a></div>
          <div class="journal-grid">
            {posts.map((post) => (
              <a class="journal-card card" href={postPath(post.slug)}>
                {post.coverUrl && <div class="journal-image"><img loading="lazy" src={post.coverUrl} alt={post.coverAlt} /></div>}
                <div class="journal-card-copy">
                  {post.minutesToRead > 0 && <p class="row-meta">{post.minutesToRead} min read</p>}
                  <h4>{post.title}</h4>
                  <span aria-hidden="true">↗</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="contact section" id="contact" aria-labelledby="contact-title">
    <div class="wrap feature-split">
      <div class="feature-copy">
        <h2 id="contact-title">Get in touch</h2>
        <p>Ask about the network, an event, a booking or a partnership.</p>
      </div>
      <ContactForm client:visible formId={formId} initialForm={contactForm} />
    </div>
  </section>
</SiteLayout>
