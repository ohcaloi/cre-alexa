---
import SiteLayout from "./SiteLayout.astro";
import "../styles/community.css";
const { title, description = "", status = "", hideHeading = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "");
const communityLinks = [
  ["/community/membership", "Membership"], ["/community/events", "Events"], ["/community/articles", "Articles"],
  ["/community/vendors", "Vendors"], ["/community/sponsors", "Sponsors"], ["/community/venues", "Venues"],
  ["/community/account", "Account"],
] as const;
const notices: Record<string, string> = {
  saved: "Your changes were saved.", invalid: "This request could not be completed. Check your details and try again.",
  code: "If the address is eligible, you’ll receive a sign-in code.", wait: "Please wait before requesting another code.",
  payment: "Payment processing is underway. Confirmed transactions appear in your account.",
  file: "Choose a PDF up to 5 MB or a JPEG or PNG up to 2 MB for a photo.",
  billing: "Test billing could not complete the request.", unavailable: "This option is currently unavailable.",
  captcha: "Sign-in needs an extra check this form can’t provide yet. Please contact us.",
  "registration-unavailable": "We couldn’t send a sign-up code right now. Please try again later.",
};
---
<SiteLayout title={`${title} | CRE Alexa`} description={description || title}>
  <div class="community-shell">
    <nav class="community-nav" aria-label="Community">
      <p class="community-nav-label">Member hub</p>
      <div class="community-nav-track">
        {communityLinks.map(([href, label]) => {
          const current = path === href || path.startsWith(`${href}/`);
          return <a href={href} class:list={{ "is-current": current, "is-account": href === "/community/account" }} aria-current={current ? "page" : undefined}>{label}</a>;
        })}
      </div>
    </nav>
    <script is:inline>
      // On narrow screens the menu scrolls sideways: bring the current page's tab into view.
      (function () {
        var track = document.querySelector(".community-nav-track");
        var current = track && track.querySelector(".is-current");
        if (current && track.scrollWidth > track.clientWidth) track.scrollLeft = current.offsetLeft - (track.clientWidth - current.offsetWidth) / 2;
      })();
    </script>
    {!hideHeading && <header class="community-heading"><h1>{title}</h1>{description && <p>{description}</p>}</header>}
    {notices[status] && <p class="community-notice" role="status">{notices[status]}</p>}
    <slot />
  </div>
</SiteLayout>
