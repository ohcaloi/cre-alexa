---
import "../styles/global.css";
import "../styles/brand.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  home?: boolean;
}
const { title, description, image, home = false } = Astro.props;
const nav = [
  { href: "/#communities", label: "Communities" },
  { href: "/events", label: "Events" },
  { href: "/#resources", label: "Resources" },
  { href: "/shop", label: "Shop" },
];
---

<!doctype html>
<html lang="en" data-type="service" data-radius="soft" data-buttons="solid" data-motion="on">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3f0ea" />
    <link rel="icon" href="/cre-icon.svg" type="image/svg+xml" />
    <meta name="page-type" content="service" />
    <meta name="site-kind" content="other" />
    {title && <Fragment><title>{title}</title><meta property="og:title" content={title} /></Fragment>}
    {description && <Fragment><meta name="description" content={description} /><meta property="og:description" content={description} /></Fragment>}
    {image && <meta property="og:image" content={image} />}
    {home && <meta property="og:type" content="website" />}
    <slot name="seo-tags" />
  </head>
  <body>
    <!-- Photo hero, Manrope, oxblood and warm stone, split navigation, dark footer. -->
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header nav">
      <div class="wrap header-inner">
        <a class="brand nav__logo" href="/" aria-label="CRE Alexa home"><span>CRE</span> Alexa<span class="brand-dot" aria-hidden="true">.</span></a>
        <nav class="site-nav" aria-label="Main navigation">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <a class="button button-small header-cta" href="/services">Book a session <span aria-hidden="true">↗</span></a>
        <details class="mobile-menu">
          <summary aria-label="Navigation menu"><span></span><span></span></summary>
          <nav aria-label="Mobile navigation">
            {nav.map((item) => <a href={item.href}>{item.label}</a>)}
            <a href="/services">Book a session</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main" tabindex="-1" class:list={[!home && "wrap inner-page"]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand footer-brand" href="/" aria-label="CRE Alexa home"><span>CRE</span> Alexa<span class="brand-dot" aria-hidden="true">.</span></a>
            <p>Commercial real estate communities in Nashville and Austin.</p>
          </div>
          <nav aria-label="Explore CRE Alexa">
            <a href="/events">Events</a>
            <a href="/blog">Articles</a>
            <a href="/shop">Shop</a>
          </nav>
          <nav aria-label="Connect with CRE Alexa">
            <a href="/services">Book a session</a>
            <a href="/plans">Plans</a>
            <a href="/reservations">Table reservations</a>
            <a href="/#contact">Contact</a>
          </nav>
        </div>
        <p class="site-credit">© {new Date().getFullYear()} CRE Alexa</p>
      </div>
    </footer>
    {home && <script type="module" src="/moments/moments.js" is:inline></script>}
    <script>
      const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu");
      menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { menu.open = false; }));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu?.open) {
          menu.open = false;
          menu.querySelector("summary")?.focus();
        }
      });
    </script>
  </body>
</html>
